# ============================================
# AI-Powered Smart Waste Management System
# Environment Variables - Copy to .env
# ============================================

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_waste
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# --- JWT Security ---
# Must be at least 32 characters (256 bits)
JWT_SECRET=your_very_long_and_secure_secret_key_minimum_32_chars

# --- Google Gemini API ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
